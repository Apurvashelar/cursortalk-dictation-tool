{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CursorTalk",
  "version": "0.1.0",
  "identifier": "com.cursortalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:macos-runtime && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CursorTalk",
        "width": 1200,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "files": {
        "Frameworks/libonnxruntime.1.17.1.dylib": "target/release/libonnxruntime.1.17.1.dylib",
        "Frameworks/libsherpa-onnx-c-api.dylib": "target/release/libsherpa-onnx-c-api.dylib",
        "Resources/llama-runtime/llama-server": "bin/llama-runtime/llama-server",
        "Resources/llama-runtime/libmtmd.0.dylib": "bin/llama-runtime/libmtmd.0.dylib",
        "Resources/llama-runtime/libllama.0.dylib": "bin/llama-runtime/libllama.0.dylib",
        "Resources/llama-runtime/libggml.0.dylib": "bin/llama-runtime/libggml.0.dylib",
        "Resources/llama-runtime/libggml-cpu.0.dylib": "bin/llama-runtime/libggml-cpu.0.dylib",
        "Resources/llama-runtime/libggml-blas.0.dylib": "bin/llama-runtime/libggml-blas.0.dylib",
        "Resources/llama-runtime/libggml-metal.0.dylib": "bin/llama-runtime/libggml-metal.0.dylib",
        "Resources/llama-runtime/libggml-base.0.dylib": "bin/llama-runtime/libggml-base.0.dylib"
      }
    }
  }
}
